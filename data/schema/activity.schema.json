{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "activity",
  "type": "object",
  "required": [
    "table",
    "items"
  ],
  "properties": {
    "table": {
      "const": "activity"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "activeKcal"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "activeKcal": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    }
  }
}
