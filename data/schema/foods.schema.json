{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "foods",
  "type": "object",
  "required": [
    "table",
    "items"
  ],
  "properties": {
    "table": {
      "const": "foods"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "serving",
          "kcal",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "protein",
              "veg_fruit",
              "grain",
              "dairy",
              "snack_drink",
              "etc"
            ]
          },
          "serving": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "amount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "kcal": {
            "type": "number",
            "minimum": 0
          },
          "carbs": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "protein": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "fat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "fiber": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "sugar": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "sodium": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "satFat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "source": {
            "enum": [
              "label",
              "estimate",
              "unknown"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
